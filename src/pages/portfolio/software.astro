---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page/PageHero.astro';
import PortfolioTabs from '../../components/page/PortfolioTabs.astro';
import Gallery from '../../components/page/Gallery.astro';
import Lightbox from '../../components/page/Lightbox.astro';
import CtaBand from '../../components/page/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { photos, portfolioPages } from '../../data/portfolio';

const page = portfolioPages.software;
const shots = photos('software');
---
<BaseLayout title={`${page.metaTitle} | ICAN Group`} description={page.description}>
  <main>
    <PageHero crumbs={[{ label: 'Home', href: '/' }, { label: 'Portfolio' }, { label: page.title }]} eyebrow="Portfolio" title={page.title} lead={page.lead}>
      <PortfolioTabs current="software" />
    </PageHero>

    <section class="pf">
      <div class="wrap">
        <div class="sec-head row">
          <h2>{shots.length} screenshots</h2>
          <a class="link" href="/solutions/software-applications">What each system does <Icon name="arrow-right" /></a>
        </div>
        <Gallery photos={shots} label={page.title} />
      </div>
    </section>

    <CtaBand heading="Need a system built around your business?" href="/contact?topic=quote&solution=software-applications" label="Get a quote" />
    <Lightbox />
  </main>
</BaseLayout>

<style>
  .pf { padding: 40px 0 72px; }
  .pf .sec-head { margin-bottom: 20px; }
  .pf h2 { font-size: 22px; }
</style>
