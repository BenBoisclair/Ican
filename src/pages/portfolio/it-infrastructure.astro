---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page/PageHero.astro';
import PortfolioTabs from '../../components/page/PortfolioTabs.astro';
import Gallery from '../../components/page/Gallery.astro';
import Lightbox from '../../components/page/Lightbox.astro';
import CtaBand from '../../components/page/CtaBand.astro';
import { bestFirst, galleries, portfolioHero, portfolioPages } from '../../data/portfolio';

const page = portfolioPages['it-infrastructure'];
const cats = galleries.filter((g) => g.page === 'it-infrastructure').map((g) => ({ ...g, photos: bestFirst(g.key) }));
const total = cats.reduce((n, c) => n + c.photos.length, 0);
---
<BaseLayout title={`${page.metaTitle} | ICAN Group`} description={page.description} image={bestFirst('datacenter')[0]} imageAlt="Server room built by ICAN">
  <main>
    <PageHero crumbs={[{ label: 'Home', href: '/' }, { label: 'Portfolio' }, { label: page.title }]} title={portfolioHero.title} lead={portfolioHero.lead} transitionName="portfolio-hero">
      <PortfolioTabs current="it-infrastructure" />
    </PageHero>

    <section class="pf">
      <div class="wrap">
        <!-- Category links: with JavaScript they filter the page; without it they jump to the category. -->
        <nav class="filter" id="categories" aria-label="Categories">
          <a href="#all" data-filter="all" aria-current="true">All <small>{total}</small></a>
          {cats.map((c) => <a href={`#${c.key}`} data-filter={c.key}>{c.title} <small>{c.photos.length}</small></a>)}
        </nav>
        {cats.map((c) => (
          <section class="cat" id={c.key} data-cat={c.key}>
            <h2>{c.title} <small>{c.photos.length} photos</small></h2>
            <Gallery photos={c.photos} label={c.title} />
          </section>
        ))}
      </div>
    </section>

    <CtaBand heading="Planning a similar project?" text="We survey, design, install and maintain, anywhere in Thailand." />
    <Lightbox />
  </main>
</BaseLayout>

<script>
  const bar = document.getElementById('categories')!;
  const links = Array.from(bar.querySelectorAll<HTMLAnchorElement>('a'));
  const cats = Array.from(document.querySelectorAll<HTMLElement>('.cat'));
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let first = true;
  const apply = () => {
    const key = location.hash.slice(1);
    const known = cats.some((c) => c.dataset.cat === key);
    const active = known ? key : 'all';
    for (const c of cats) {
      const show = active === 'all' || c.dataset.cat === active;
      c.hidden = !show;
      if (show && !first && !still) {
        c.animate([{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }], { duration: 320, easing: 'cubic-bezier(.2, .7, .2, 1)' });
      }
    }
    first = false;
    for (const a of links) a.toggleAttribute('aria-current', a.dataset.filter === active);
    // The browser jumped to where the category was before the others were hidden: bring the bar back into view.
    if (known) bar.scrollIntoView({ block: 'start', behavior: still ? 'auto' : 'smooth' });
  };
  window.addEventListener('hashchange', apply);
  apply();
  // On arrival the browser scrolls to the category heading after this runs; show the bar above it instead.
  if (location.hash.length > 1) {
    const reveal = () => requestAnimationFrame(() => { if (cats.some((c) => c.dataset.cat === location.hash.slice(1))) bar.scrollIntoView({ block: 'start' }); });
    if (document.readyState === 'complete') reveal(); else window.addEventListener('load', reveal, { once: true });
  }
</script>

<style>
  .pf { padding: 32px 0 72px; }
  .filter { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
  .filter a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 999px; background: #fff; border: 1px solid #DCE4F3; font-size: 14px; font-weight: 500; transition: border-color .25s, background-color .25s, color .25s; }
  .filter a:hover { border-color: var(--blue-500); color: var(--blue); }
  .filter a[aria-current] { background: var(--blue); border-color: var(--blue); color: #fff; }
  .filter small { font-size: 12px; opacity: .7; }
  .cat { padding-top: 32px; }
  .cat[hidden] { display: none; }
  .cat h2 { margin-bottom: 14px; font-size: 22px; }
  .cat h2 small { margin-left: 6px; font-size: 14px; font-weight: 500; color: var(--muted); }
</style>
