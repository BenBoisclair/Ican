---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page/PageHero.astro';
import Sections from '../../components/page/Sections.astro';
import Gallery from '../../components/page/Gallery.astro';
import Lightbox from '../../components/page/Lightbox.astro';
import CtaBand from '../../components/page/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { solutions, solutionHref, type Solution, type SolutionPage } from '../../data/solutions';
import { bestFirst, galleries, galleryHref, photos } from '../../data/portfolio';
import { img } from '../../lib/assets';

export function getStaticPaths() {
  return solutions.filter((s) => s.page).map((s) => ({ params: { slug: s.slug }, props: { solution: s } }));
}

const { solution } = Astro.props as { solution: Solution };
const page = solution.page as SolutionPage;
const quoteHref = `/contact?topic=quote&solution=${solution.slug}`;
const keys = page.galleries ?? [];
const single = keys.length === 1 ? keys[0] : undefined;
const cards = keys.length > 1 ? keys.map((k) => {
  const g = galleries.find((x) => x.key === k)!;
  return { title: g.title, href: galleryHref(k), cover: bestFirst(k)[0], count: photos(k).length };
}) : [];
const others = solutions.filter((s) => s.slug !== solution.slug);
// Shared with the page photo, or the best photo of its first gallery.
const sharePhoto = page.image ? img(page.image) : keys[0] ? bestFirst(keys[0])[0] : undefined;
---
<BaseLayout title={`${page.metaTitle} | ICAN Group`} description={page.description} image={sharePhoto} imageAlt={page.imageAlt ?? solution.title}>
  <main>
    <PageHero
      crumbs={[{ label: 'Home', href: '/' }, { label: 'Solutions', href: '/#solutions' }, { label: solution.title }]}
      eyebrow="Solutions"
      title={solution.title}
      lead={page.lead}
      facts={page.facts}
      image={page.image}
      imageAlt={page.imageAlt}
    >
      <div class="ctas">
        <a class="btn btn-primary btn-lg" href={quoteHref}>Get a quote <Icon name="arrow-right" /></a>
        {page.download && (
          <a class="btn btn-ghost btn-lg" href={page.download.href} download><Icon name="download" />{page.download.label}</a>
        )}
      </div>
      {page.download && <p class="note">{page.download.note}</p>}
    </PageHero>

    <Sections sections={page.sections} />

    {keys.length > 0 && (
      <section class="work">
        <div class="wrap">
          <div class="sec-head row rv">
            <h2>Our work</h2>
            <a class="link" href={galleryHref(keys[0])}>See the portfolio <Icon name="arrow-right" /></a>
          </div>
          {single && <div class="rv"><Gallery photos={bestFirst(single)} label={galleries.find((g) => g.key === single)!.title} limit={8} /></div>}
          {cards.length > 0 && (
            <ul class="gcards" role="list">
              {cards.map((c, i) => (
                <li class="rv" style={`--d:${i * 60}ms`}>
                  <a href={c.href}>
                    <Image src={c.cover} alt="" widths={[300, 600]} sizes="(max-width: 640px) 46vw, 230px" />
                    <span><strong>{c.title}</strong><small>{c.count} photos</small></span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )}

    <section class="others">
      <div class="wrap">
        <h2 class="rv">Other solutions</h2>
        <ul role="list" class="rv">
          {others.map((s) => <li><a href={solutionHref(s)}><Icon name={s.icon} size={17} />{s.title}</a></li>)}
          <li><a href="/#chang"><Icon name="wrench" size={17} />Chang ICAN technicians</a></li>
        </ul>
      </div>
    </section>

    <CtaBand heading={`Talk to us about ${solution.title}`} href={quoteHref} label="Get a quote" />
    {single && <Lightbox />}
  </main>
</BaseLayout>

<style>
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .note { margin-top: 8px; font-size: 13px; color: var(--muted); }
  .work { padding: 56px 0 64px; }
  .work .sec-head { margin-bottom: 24px; }
  .work h2, .others h2 { font-size: clamp(24px, 2.6vw, 30px); }
  .gcards { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin: 0; padding: 0; list-style: none; }
  .gcards a { display: block; overflow: hidden; border-radius: 14px; border: 1px solid var(--line); background: #fff; transition: border-color .2s; }
  .gcards a:hover { border-color: #B9C8EA; }
  .gcards :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .gcards span { display: block; padding: 10px 12px 12px; }
  .gcards strong { display: block; font-size: 14.5px; }
  .gcards small { font-size: 13px; color: var(--muted); }
  .others { padding: 48px 0 56px; background: var(--tint); }
  .others ul { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; }
  .others a { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 999px; background: #fff; border: 1px solid #DCE4F3; font-size: 14.5px; font-weight: 500; transition: border-color .2s, color .2s; }
  .others a:hover { border-color: var(--blue-500); color: var(--blue); }
  .others :global(svg) { color: var(--blue); }
  @media (max-width: 960px) { .gcards { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) { .gcards { grid-template-columns: repeat(2, 1fr); } }
</style>
