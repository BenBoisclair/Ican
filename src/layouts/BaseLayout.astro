---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-sans-thai/500.css';
import '@fontsource/ibm-plex-sans-thai/600.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { analytics } from '../data/analytics';
import { seo } from '../data/seo';
import type { ImageMetadata } from 'astro';
import { canonical, ld, organizationLd, shareImage, SITE_NAME, websiteLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Photo used when the page is shared (cropped to 1200×630); the branded ICAN image otherwise. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}
const { title, description, image, imageAlt, noindex = false } = Astro.props;
const url = canonical(Astro.url.pathname, Astro.site);
const share = await shareImage(image, imageAlt, Astro.site);
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}

    <!-- Icons: browser tab, iPhone home screen, Android -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#143A93" />

    <!-- Sharing previews (LINE, Facebook, LinkedIn, X, WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={share.url} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={share.url} />
    <meta name="twitter:image:alt" content={share.alt} />

    {seo.googleSiteVerification && <meta name="google-site-verification" content={seo.googleSiteVerification} />}
    {isHome && <script type="application/ld+json" set:html={ld([organizationLd(Astro.site), websiteLd(Astro.site)])} />}
    <script is:inline>
      document.documentElement.classList.add('js');
      // Safety net: if the motion script hasn't wired up the scroll reveal within 3s, show everything.
      setTimeout(function () {
        if (document.documentElement.dataset.motion !== 'ready') document.documentElement.classList.remove('js');
      }, 3000);
    </script>
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
    {analytics.measurementId && <ConsentBanner />}
    <script>
      import { initMotion } from '../scripts/motion';
      import { initAnalytics } from '../scripts/analytics';
      initMotion();
      initAnalytics();
    </script>
  </body>
</html>
