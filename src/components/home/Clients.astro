---
import { Image } from 'astro:assets';
import { clients } from '../../data/home';
import { img } from '../../lib/assets';
---
<section id="clients" class="clients">
  <div class="wrap">
    <div class="sec-head rv"><span class="eyebrow">{clients.eyebrow}</span><h2>{clients.heading}</h2></div>
    <div class="logo-grid">
      {clients.logos.map((l, i) => (
        <div class="lg rv" style={`--d:${(i % 6) * 60}ms`}>
          <Image src={img(l.file)} alt={l.name} class:list={[{ white: l.white }]} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .clients { padding: 96px 0; background: var(--tint); }
  .logo-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .lg { flex: 0 0 calc((100% - 60px) / 6); display: grid; place-items: center; aspect-ratio: 3 / 2; padding: 14px; background: #fff; border: 1px solid #E6EBF3; border-radius: 12px; }
  .lg :global(img) { max-height: 64px; max-width: 100%; width: auto; object-fit: contain; }
  .lg :global(img.white) { filter: brightness(0); opacity: .72; }
  @media (max-width: 960px) { .lg { flex-basis: calc((100% - 36px) / 4); } }
  @media (max-width: 640px) { .logo-grid { gap: 8px; } .lg { flex-basis: calc((100% - 16px) / 3); padding: 10px; } .lg :global(img) { max-height: 44px; } }
</style>
