---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import CountUp from '../islands/CountUp.vue';
import { hero } from '../../data/home';
import { img } from '../../lib/assets';
---
<section class="hero" id="hero">
  <div class="blob b1" aria-hidden="true"></div>
  <div class="blob b2" aria-hidden="true"></div>
  <div class="wrap grid">
    <div class="copy">
      <h1 class="rv">
        {hero.titleLead}{' '}<span class="hl">{hero.titleHighlight}<svg viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 16 C 90 6, 200 4, 396 12" /></svg></span>
      </h1>
      <p class="lead rv" style="--d:160ms">{hero.lead}</p>
      <div class="ctas rv" style="--d:240ms">
        {hero.ctas.map((c) => (
          <a class:list={['btn', 'btn-lg', c.variant === 'primary' ? 'btn-primary' : 'btn-ghost']} href={c.href}>
            {c.label}{c.arrow && <Icon name="arrow-right" />}
          </a>
        ))}
      </div>
      <div class="trusted rv" style="--d:320ms">
        <p class="t">{hero.trustedText} <b>{hero.trustedCount}</b>{hero.trustedSuffix}</p>
        <div class="row">
          {hero.trustedLogos.map((l) => (
            <Image src={img(l.file)} alt={l.name} height={l.height ?? 28} densities={[1, 2]} style={`height:${l.height ?? 28}px`} />
          ))}
        </div>
      </div>
    </div>
    <div class="collage rv" style="--d:200ms">
      <div class="c-main">
        <Image src={img(hero.images.main)} alt={hero.images.mainAlt} widths={[640, 960, 1280]} sizes="(max-width: 960px) 90vw, 470px" loading="eager" fetchpriority="high" />
      </div>
      <div class="c-second">
        <Image src={img(hero.images.second)} alt={hero.images.secondAlt} widths={[400, 640]} sizes="(max-width: 960px) 50vw, 300px" loading="eager" />
      </div>
      {hero.cards.map((card, i) => (
        <div class={`fcard fc${i + 1}`}>
          <span class="fi"><Icon name={card.icon} size={i === 2 ? 18 : 22} /></span>
          <div>
            {card.countTo ? <CountUp client:visible to={card.countTo} /> : <strong>{card.value}</strong>}
            {card.label && <span>{card.label}</span>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding: 76px 0 96px; overflow: hidden; background: linear-gradient(180deg, #F2F6FE 0%, #FAFCFF 70%, #fff 100%); }
  .hero::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(20, 58, 147, .14) 1px, transparent 1.3px); background-size: 22px 22px; -webkit-mask-image: radial-gradient(ellipse 55% 75% at 78% 45%, #000 0%, transparent 72%); mask-image: radial-gradient(ellipse 55% 75% at 78% 45%, #000 0%, transparent 72%); }
  .blob { position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none; }
  .b1 { width: 560px; height: 560px; background: #C3D5FF; right: -160px; top: -180px; opacity: .7; }
  .b2 { width: 420px; height: 420px; background: #E1EAFF; left: -160px; bottom: -200px; opacity: .9; }
  .grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.02fr 1fr; gap: 56px; align-items: center; }
  h1 { font-size: clamp(40px, 5.4vw, 66px); line-height: 1.04; font-weight: 700; letter-spacing: -.025em; margin: 0 0 22px; }
  .hl { position: relative; color: var(--blue); white-space: nowrap; }
  .hl svg { position: absolute; left: -2%; bottom: -.16em; width: 104%; height: .32em; overflow: visible; }
  .hl path { fill: none; stroke: #6E9BF5; stroke-width: 7; stroke-linecap: round; stroke-dasharray: 420; stroke-dashoffset: 0; }
  .lead { font-size: 19.5px; line-height: 1.6; color: #46526E; max-width: 470px; }
  .ctas { display: flex; gap: 12px; margin-top: 34px; flex-wrap: wrap; }
  .trusted { margin-top: 44px; }
  .t { font-size: 13px; font-weight: 600; color: #7A86A0; letter-spacing: .02em; }
  .t b { color: var(--ink); }
  .row { display: flex; align-items: center; gap: 14px 28px; flex-wrap: wrap; margin-top: 16px; }
  .row :global(img) { width: auto; filter: grayscale(1) contrast(1.1); opacity: .55; transition: opacity .2s, filter .2s; }
  .row :global(img:hover) { filter: none; opacity: 1; }

  .collage { position: relative; height: 560px; }
  .c-main { position: absolute; right: 0; top: 0; width: 80%; height: 78%; border-radius: 24px; overflow: hidden; box-shadow: 0 34px 70px rgba(15, 27, 51, .24); }
  .c-second { position: absolute; left: 0; bottom: 0; width: 52%; height: 46%; border-radius: 20px; overflow: hidden; border: 6px solid #fff; box-shadow: 0 24px 50px rgba(15, 27, 51, .22); }
  .c-main :global(img), .c-second :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .fcard { position: absolute; z-index: 2; display: flex; align-items: center; gap: 14px; background: #fff; border-radius: 16px; padding: 14px 18px 14px 14px; box-shadow: 0 18px 44px rgba(15, 27, 51, .18); }
  .fi { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--tint-2); color: var(--blue); }
  .fcard :global(strong) { display: block; font-size: 24px; line-height: 1.05; color: var(--ink); font-variant-numeric: tabular-nums; }
  .fcard div > span { display: block; font-size: 13px; color: var(--muted); margin-top: 2px; }
  .fc1 { left: 6%; top: 9%; }
  .fc2 { right: -3%; bottom: 14%; }
  .fc2 :global(strong) { font-size: 17px; letter-spacing: .01em; }
  .fc3 { left: 47%; top: -4%; padding: 10px 14px 10px 10px; }
  .fc3 .fi { width: 34px; height: 34px; border-radius: 9px; background: #E8F7EE; color: #16A34A; }
  .fc3 :global(strong) { font-size: 15px; }

  @media (prefers-reduced-motion: no-preference) {
    .fcard { animation: float 6s ease-in-out infinite alternate; }
    .fc2 { animation-delay: -2s; }
    .fc3 { animation-delay: -4s; }
    :global(.js) .hl path { stroke-dashoffset: 420; transition: stroke-dashoffset 1.1s var(--ease) .7s; }
    :global(.js) h1:global(.in) .hl path { stroke-dashoffset: 0; }
  }
  @keyframes float { from { transform: translateY(0); } to { transform: translateY(-10px); } }

  @media (max-width: 960px) { .grid { grid-template-columns: 1fr; gap: 48px; } .collage { height: 460px; } }
  @media (max-width: 560px) {
    .collage { height: 360px; }
    .fcard { padding: 10px 12px 10px 10px; gap: 10px; }
    .fi { width: 34px; height: 34px; }
    .fcard :global(strong) { font-size: 18px; }
    .fc2 :global(strong) { font-size: 14px; }
    .fc3 { display: none; }
    .fc1 { left: 0; }
    .fc2 { right: 0; }
    .row { gap: 12px 22px; }
  }
</style>
