---
import Icon from '../Icon.astro';
import { why } from '../../data/home';
---
<section id="why" class="why">
  <div class="wrap grid">
    <div class="intro">
      <span class="eyebrow rv">{why.eyebrow}</span>
      <h2 class="rv" style="--d:60ms">{why.heading}</h2>
      <a class="btn btn-primary rv" style="--d:120ms" href={why.cta.href}>{why.cta.label} <Icon name="arrow-right" /></a>
      <div class="certs rv" style="--d:180ms">
        <h4><Icon name="badge-check" size={20} />{why.certsTitle}</h4>
        {why.certs.map((c) => (
          <div class="cert-row"><span class="k">{c.key}</span><span class="chips">{c.chips.map((chip) => <b>{chip}</b>)}</span></div>
        ))}
      </div>
    </div>
    <div class="items">
      {why.items.map((item, i) => (
        <div class="item rv" style={`--d:${(i % 2) * 90}ms`}>
          <span class="wi"><Icon name={item.icon} size={21} /></span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why { padding: 104px 0; }
  .grid { display: grid; grid-template-columns: 5fr 7fr; gap: 64px; align-items: start; }
  h2 { margin: 12px 0 28px; }
  .certs { margin-top: 40px; padding: 24px; border: 1px solid var(--line); border-radius: 16px; }
  h4 { display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 600; margin-bottom: 16px; }
  h4 :global(svg) { color: var(--blue); }
  .cert-row { display: grid; grid-template-columns: 96px 1fr; gap: 12px; align-items: baseline; padding: 10px 0; border-top: 1px solid #EEF1F6; }
  .k { font-size: 12.5px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #7B869C; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips b { font-size: 13.5px; font-weight: 500; padding: 5px 10px; border-radius: 999px; background: var(--tint-2); color: var(--blue); }
  .items { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .item { padding: 26px; border-radius: 16px; background: var(--tint); }
  .wi { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 10px; background: #fff; color: var(--blue); box-shadow: 0 2px 6px rgba(20, 58, 147, .08); }
  h3 { font-size: 18px; margin: 16px 0 8px; }
  p { font-size: 15.5px; line-height: 1.6; color: var(--muted); }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr; gap: 40px; } }
  @media (max-width: 640px) { .items { grid-template-columns: 1fr; } .cert-row { grid-template-columns: 1fr; gap: 6px; } }
</style>
