---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { projects } from '../../data/home';
import { img } from '../../lib/assets';
---
<section id="work" class="work">
  <div class="wrap">
    <div class="sec-head row rv">
      <div><span class="eyebrow">{projects.eyebrow}</span><h2>{projects.heading}</h2></div>
      <a class="link" href={projects.allHref}>{projects.allLabel} <Icon name="arrow-right" /></a>
    </div>
    <div class="grid">
      {projects.items.map((p, i) => (
        <a class="tile rv" style={`--d:${(i % 3) * 90}ms`} href={p.href}>
          <div class="imgbox">
            <Image src={img(p.image)} alt="" widths={[480, 800]} sizes="(max-width: 640px) 92vw, (max-width: 960px) 46vw, 380px" />
          </div>
          <span class="cap"><span class="cat">{p.category}</span><strong>{p.title}</strong></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .work { padding: 96px 0 110px; border-top: 1px solid #EEF1F6; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 20px; }
  .tile { display: block; margin: 0; }
  .imgbox { border-radius: 16px; overflow: hidden; aspect-ratio: 4 / 3; background: var(--tint); }
  /* Photos stay still: no scroll movement, no hover zoom. */
  .imgbox :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .cap { display: block; padding: 10px 4px 0; }
  .tile:hover strong { color: var(--blue); }
  .cat { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--blue-500); }
  strong { display: block; margin-top: 4px; font-size: 17px; }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; gap: 28px; } }
</style>
