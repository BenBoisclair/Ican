---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { startEasy as s } from '../../data/home';
import { img } from '../../lib/assets';
---
<div class="easy rv" id="chang">
  <div class="easy-media">
    <Image class="main" src={img(s.images.main)} alt={s.images.mainAlt} widths={[460, 920]} sizes="(max-width: 960px) 90vw, 380px" />
    <Image class="second" src={img(s.images.second)} alt={s.images.secondAlt} widths={[160, 320]} sizes="120px" />
  </div>
  <div class="easy-body">
    <span class="eyebrow">{s.eyebrow} <span class="th">{s.thaiName}</span></span>
    <h3>{s.title}</h3>
    <p>{s.text}</p>
    <div class="chips">
      {s.chips.map((c) => <b><Icon name={c.icon} size={15} />{c.label}</b>)}
    </div>
    <div class="ctas">
      <a class="btn btn-primary" href={s.phone.tel}><Icon name="phone" />{s.callLabel} {s.phone.display}</a>
      <span class="lineq">
        <a class="btn btn-line" href={s.lineUrl} target="_blank" rel="noopener" aria-describedby="lineqr"><Icon name="message-circle" />{s.lineLabel}</a>
        <span class="pop" id="lineqr" role="tooltip">
          <Image src={img(s.lineQr)} alt="LINE QR code for Chang ICAN" width={140} densities={[1, 2]} />
          {s.lineQrCaption}
        </span>
      </span>
      <a class="link" href={s.allServicesHref}>{s.allServicesLabel} <Icon name="arrow-right" /></a>
    </div>
  </div>
</div>

<style>
  .easy { margin-top: 24px; display: grid; grid-template-columns: 400px 1fr; gap: 36px; align-items: center; padding: 20px 32px 20px 20px; border-radius: 18px; background: linear-gradient(120deg, #EAF1FF 0%, #F6F9FF 60%); border: 1px solid #DCE6FA; }
  /* The secondary photo sits top-right, over the curtain area only: every face in the team photo is below ~35% of its height. */
  .easy-media { position: relative; padding: 8% 4% 0 0; }
  .easy-media :global(.main) { border-radius: 12px; aspect-ratio: 4 / 3; object-fit: cover; width: 100%; box-shadow: 0 14px 30px rgba(15, 27, 51, .16); }
  .easy-media :global(.second) { position: absolute; right: 0; top: 0; width: 28%; aspect-ratio: 1; object-fit: cover; border-radius: 10px; border: 4px solid #fff; box-shadow: 0 10px 24px rgba(15, 27, 51, .2); }
  .eyebrow .th { letter-spacing: 0; text-transform: none; font-weight: 500; color: #7B869C; margin-left: 4px; }
  h3 { font-size: 34px; line-height: 1.1; letter-spacing: -.015em; margin: 8px 0 10px; }
  p { font-size: 16px; line-height: 1.55; color: #3F4B66; max-width: 560px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .chips b { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 500; padding: 6px 12px; border-radius: 999px; background: #fff; color: var(--ink); border: 1px solid #DCE4F3; }
  .chips :global(svg) { color: var(--blue); }
  .ctas { display: flex; align-items: center; gap: 12px; margin-top: 22px; flex-wrap: wrap; }
  .lineq { position: relative; }
  .pop { position: absolute; left: 50%; bottom: calc(100% + 10px); width: 160px; padding: 10px; border-radius: 12px; background: #fff; box-shadow: 0 16px 40px rgba(15, 27, 51, .2); text-align: center; font-size: 12.5px; color: var(--muted); opacity: 0; visibility: hidden; transform: translateX(-50%) translateY(6px); transition: opacity .18s, transform .18s, visibility .18s; }
  .pop :global(img) { width: 140px; height: 140px; margin: 0 auto 6px; }
  .lineq:hover .pop, .lineq:focus-within .pop { opacity: 1; visibility: visible; transform: translateX(-50%); }
  .btn-line { background: #06C755; color: #fff; }
  .btn-line:hover { background: #05B34C; }
  @media (max-width: 960px) { .easy { grid-template-columns: 1fr; padding: 20px; } .easy-media { max-width: 460px; } }
</style>
