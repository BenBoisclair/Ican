---
// Renders a Lucide icon as static SVG (no client JavaScript).
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;
const Svg = icons[name];
---
<Svg size={size} class={className} aria-hidden="true" />
