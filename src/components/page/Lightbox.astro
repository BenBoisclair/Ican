---
// Full-size photo viewer for every Gallery on the page: buttons or arrow keys to move, Escape to close.
import Icon from '../Icon.astro';
---
<dialog id="lightbox" class="lightbox" aria-label="Photo viewer">
  <figure>
    <figcaption><span class="cap"></span> <span class="count"></span></figcaption>
  </figure>
  <button class="nav prev" type="button" aria-label="Previous photo"><Icon name="chevron-left" size={28} /></button>
  <button class="nav next" type="button" aria-label="Next photo"><Icon name="chevron-right" size={28} /></button>
  <button class="close" type="button" aria-label="Close" autofocus><Icon name="x" size={24} /></button>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dialog && typeof dialog.showModal === 'function') {
    // Added only while the viewer is open, so the page never holds an image without a source.
    const image = document.createElement('img');
    const figure = dialog.querySelector('figure')!;
    const cap = dialog.querySelector('.cap')!;
    const count = dialog.querySelector('.count')!;
    let links: HTMLAnchorElement[] = [];
    let index = 0;

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const a = links[index];
      image.style.opacity = '0';
      image.onload = () => { image.style.opacity = '1'; };
      image.src = a.href;
      if (image.complete) image.style.opacity = '1';
      image.alt = a.dataset.caption ?? '';
      cap.textContent = a.dataset.caption ?? '';
      count.textContent = `${index + 1} / ${links.length}`;
    };

    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-lb]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      // Move through the photos that are visible (a filtered gallery hides the rest), or all of them with data-lb-all.
      const group = a.closest('[data-lb-group]');
      const all = group?.hasAttribute('data-lb-all') ?? false;
      links = Array.from(group?.querySelectorAll<HTMLAnchorElement>('a[data-lb]') ?? [a]).filter((l) => all || l.offsetParent !== null);
      figure.prepend(image);
      show(Math.max(links.indexOf(a), 0));
      dialog.showModal();
    });
    dialog.querySelector('.prev')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.next')!.addEventListener('click', () => show(index + 1));
    // Fade out, then close. Escape goes through the same path.
    const hide = () => {
      if (still || dialog.classList.contains('closing')) { dialog.close(); return; }
      dialog.classList.add('closing');
      dialog.addEventListener('animationend', () => { dialog.classList.remove('closing'); dialog.close(); }, { once: true });
    };
    dialog.addEventListener('cancel', (e) => { e.preventDefault(); hide(); });
    dialog.querySelector('.close')!.addEventListener('click', hide);
    dialog.addEventListener('click', (e) => { if (e.target === dialog) hide(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => { image.removeAttribute('src'); image.remove(); });
  }
</script>

<style>
  .lightbox { width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(8, 14, 30, .94); color: #fff; }
  .lightbox::backdrop { background: rgba(8, 14, 30, .6); }
  .lightbox[open] { animation: lb-in .28s cubic-bezier(.2, .7, .2, 1); }
  .lightbox.closing { animation: lb-out .2s ease forwards; }
  @keyframes lb-in { from { opacity: 0; } }
  @keyframes lb-out { to { opacity: 0; } }
  figure { display: grid; place-items: center; gap: 12px; height: 100%; margin: 0; padding: 56px 72px 24px; }
  figure :global(img) { transition: opacity .25s ease; max-width: 100%; max-height: calc(100vh - 120px); object-fit: contain; border-radius: 8px; }
  figcaption { font-size: 14px; color: #C9D3E8; }
  .count { margin-left: 10px; opacity: .7; }
  button { position: absolute; display: grid; place-items: center; width: 48px; height: 48px; padding: 0; border: 0; border-radius: 50%; background: rgba(255, 255, 255, .1); color: #fff; cursor: pointer; transition: background .2s; }
  button:hover { background: rgba(255, 255, 255, .22); }
  .prev { left: 14px; top: 50%; transform: translateY(-50%); }
  .next { right: 14px; top: 50%; transform: translateY(-50%); }
  .close { top: 12px; right: 14px; }
  @media (max-width: 640px) {
    figure { padding: 60px 8px 80px; }
    .prev, .next { top: auto; bottom: 16px; transform: none; }
    .prev { left: calc(50% - 60px); }
    .next { right: calc(50% - 60px); }
  }
</style>
