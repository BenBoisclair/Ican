---
// Switches between the two portfolio pages. The active tab carries a view-transition name, so when the page
// changes the blue highlight slides across instead of jumping.
import { portfolioPages } from '../../data/portfolio';

interface Props { current: keyof typeof portfolioPages }
const { current } = Astro.props;
---
<nav class="tabs" aria-label="Portfolio">
  {Object.entries(portfolioPages).map(([key, p]) => (
    <a href={p.href} aria-current={key === current ? 'page' : undefined}>{p.title}</a>
  ))}
</nav>

<style>
  .tabs { display: inline-grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-top: 24px; padding: 4px; border-radius: 12px; background: #fff; border: 1px solid #DCE4F3; }
  a { padding: 9px 16px; border-radius: 9px; font-size: 14.5px; font-weight: 600; text-align: center; white-space: nowrap; color: var(--muted); transition: background-color .25s, color .25s; }
  a:hover { color: var(--blue); background: var(--tint); }
  a[aria-current="page"] { view-transition-name: portfolio-tab; background: var(--blue); color: #fff; }
  @media (max-width: 420px) { a { padding: 9px 10px; font-size: 13.5px; } }
</style>
