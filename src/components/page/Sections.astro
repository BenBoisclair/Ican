---
// Renders the content blocks of a solution page (see Section in data/solutions.ts).
import Icon from '../Icon.astro';
import type { Section } from '../../data/solutions';

interface Props { sections: Section[] }
const { sections } = Astro.props;
---
{sections.map((s, n) => (
  <section class:list={['block', { alt: n % 2 === 1 }]}>
    <div class="wrap">
      <div class="head rv">
        <h2>{s.heading}</h2>
        {'intro' in s && s.intro && <p class="intro">{s.intro}</p>}
      </div>

      {s.type === 'cards' && (
        <ul class:list={['cards', { two: s.items.length <= 2 }]} role="list">
          {s.items.map((c, i) => {
            const body = (
              <Fragment>
                <span class="ico"><Icon name={c.icon} size={20} /></span>
                <span><h3>{c.title}{c.href && <Icon name="arrow-right" size={16} />}</h3><p>{c.text}</p></span>
              </Fragment>
            );
            return <li class="rv" style={`--d:${(i % 3) * 60}ms`}>{c.href ? <a class="card" href={c.href}>{body}</a> : <div class="card">{body}</div>}</li>;
          })}
        </ul>
      )}

      {s.type === 'steps' && (
        <ol class="steps" role="list">
          {s.items.map((st, i) => (
            <li class="rv" style={`--d:${i * 60}ms`}><span class="num">{i + 1}</span><h3>{st.title}</h3><p>{st.text}</p></li>
          ))}
        </ol>
      )}

      {s.type === 'chips' && (
        <ul class="chips rv" role="list">{s.items.map((c) => <li>{c}</li>)}</ul>
      )}

      {s.type === 'checks' && (
        <ul class="checks rv" role="list">{s.items.map((c) => <li><Icon name="check" size={18} />{c}</li>)}</ul>
      )}

      {s.type === 'apps' && (
        <div class="apps">
          {s.groups.map((g) => (
            <div class="group rv">
              <h3>{g.name}</h3>
              <dl>{g.items.map((a) => <div><dt>{a.title}</dt><dd>{a.text}</dd></div>)}</dl>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
))}

<style>
  .block { padding: 56px 0; }
  .alt { background: var(--tint); }
  .head { margin-bottom: 24px; max-width: 720px; }
  h2 { font-size: clamp(24px, 2.6vw, 30px); }
  .intro { margin-top: 8px; font-size: 16px; line-height: 1.55; color: var(--muted); }

  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px 14px; margin: 0; padding: 0; list-style: none; }
  .cards.two { grid-template-columns: repeat(2, 1fr); }
  .card { display: grid; grid-template-columns: 40px 1fr; gap: 14px; height: 100%; padding: 16px 18px; background: #fff; border: 1px solid var(--line); border-radius: 14px; }
  a.card { transition: border-color .2s; }
  a.card:hover { border-color: #B9C8EA; }
  a.card h3 :global(svg) { margin-left: 6px; vertical-align: -2px; color: var(--blue); }
  .ico { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: var(--tint-2); color: var(--blue); }
  .card h3 { font-size: 16px; line-height: 1.3; }
  .card p { margin-top: 4px; font-size: 14px; line-height: 1.5; color: var(--muted); }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 0; padding: 0; list-style: none; counter-reset: none; }
  .steps li { position: relative; padding: 18px; background: #fff; border: 1px solid var(--line); border-radius: 14px; }
  .num { display: grid; place-items: center; width: 30px; height: 30px; margin-bottom: 12px; border-radius: 50%; background: var(--blue); color: #fff; font-weight: 700; font-size: 14px; }
  .steps h3 { font-size: 16px; }
  .steps p { margin-top: 4px; font-size: 14px; line-height: 1.5; color: var(--muted); }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .chips li { padding: 8px 14px; border-radius: 999px; background: #fff; border: 1px solid #DCE4F3; font-size: 14.5px; font-weight: 500; }

  .checks { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px 28px; margin: 0; padding: 0; list-style: none; max-width: 960px; }
  .checks li { display: flex; gap: 10px; font-size: 15.5px; line-height: 1.5; }
  .checks :global(svg) { flex: none; margin-top: 2px; color: var(--blue); }

  .apps { columns: 2; column-gap: 16px; }
  .group { break-inside: avoid; margin-bottom: 16px; padding: 18px 20px; background: #fff; border: 1px solid var(--line); border-radius: 14px; }
  .group h3 { font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--blue-500); }
  dl { margin: 10px 0 0; }
  dl div { padding: 9px 0; border-top: 1px solid #EEF1F6; }
  dl div:first-child { border-top: 0; padding-top: 0; }
  dt { font-weight: 600; font-size: 15px; }
  dd { margin: 2px 0 0; font-size: 14px; line-height: 1.5; color: var(--muted); }

  @media (max-width: 960px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
    .steps { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .block { padding: 40px 0; }
    .cards, .cards.two, .steps, .checks { grid-template-columns: 1fr; }
    .apps { columns: 1; }
  }
</style>
