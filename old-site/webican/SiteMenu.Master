                                               <a class="collapse-item" href="#.">ประเภทการซ่อม</a>
                                               <a class="collapse-item" href="#">สิทธิ์</a>
                                         </li>--%>
                                         <li class="dropdown" runat="server">
            <a class="dropdown-toggle" data-toggle="dropdown" href="#"><asp:Label ID="Label9" Text="<%$Resources:Resource,portfolio %>" runat="server" /> <b class="caret"></b></a>
                      <ul class="dropdown-menu" runat="server">
                <li><a href="portfolio_datacenter.aspx"  runat="server">IT INFRASTRUCTURE</a></li>
                <li><a href="portfolio_software.aspx"  runat="server">SOFTWARE & APPLICATION</a></li>
          
            </ul>
  </li>
                                     
                                    <li role="presentation" runat="server"><a href="http://shop.ican.co.th/" target="_blank"">
                                        <asp:Label ID="Label7" Text="<%$Resources:Resource,shop %>" runat="server" /></a></li>
                                    <li role="presentation" runat="server"><a href="contact_us">
                                        <asp:Label ID="Label4" Text="<%$Resources:Resource,contact %>" runat="server" /></a></li>
                                    <li role="presentation" runat="server" ><a href="join_us.aspx" >
                                        <asp:Label ID="Label5" Text="<%$Resources:Resource,job %>" runat="server" /></a></li>
                                    <li role="presentation" runat="server"><a href="portal.aspx">
                                        <asp:Label ID="Label6" Text="<%$Resources:Resource,foremp %>" runat="server" /></a></li>
                                    <li role="presentation" runat="server"><a>
                                        <asp:DropDownList ID="ddlLanguages" runat="server" AutoPostBack="true" OnSelectedIndexChanged="ddlLanguages_SelectedIndexChanged">
                                            <asp:ListItem Text="Thai" Value="th" />
                                            <asp:ListItem Text="English" Value="en-us" />
                                        </asp:DropDownList></a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <div>
            <asp:ContentPlaceHolder ID="body" runat="server">
            </asp:ContentPlaceHolder>
        </div>


        <footer>
