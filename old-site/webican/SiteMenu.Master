                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                                <span class="icon-bar"></span>
                            </button>
                            <div class="navbar-brand">
                                <a href="home.aspx"><span>
                                    <img src="Content/Logo/LOGO_ICAN.png" width="150" height="60" />
                                </span></a>
                            </div>
                        </div>

                        <div class="navbar-collapse collapse">
                            <div class="menu">
                                <ul class="nav nav-tabs" role="tablist">
                                    <li role="presentation" runat="server"><a href="home.aspx">
                                        <asp:Label ID="Label1" Text="<%$Resources:Resource,home %>" runat="server" />
                                    </a></li>
                                    <li role="presentation" runat="server"><a href="about.aspx">
                                        <asp:Label ID="Label2" Text="<%$Resources:Resource,about %>" runat="server" /></a></li>
                                    <li role="presentation" runat="server"><a href="service_product.aspx">
                                        <asp:Label ID="Label3" Text="<%$Resources:Resource,serviceandproduct %>" runat="server" /></a></li>
                                        
                                    <%-- <li role="presentation" runat="server"><a href="portfolio.aspx" target="_blank"">
