                            Copyright &copy;International Computing And Networking Co.,Ltd. All rights reserved.
                        </div>
                    </div>
                </div>

                <div class="pull-right">
                    <a href="#home" class="scrollup"><i class="fa fa-angle-up fa-3x"></i></a>
                </div>
            </div>

